[Unit]
Description=nac content server (public site)
After=network.target

[Service]
Type=simple
User=nac-public
Group=nac-public
SupplementaryGroups=nac-share
WorkingDirectory=/srv/nac
# 只监听回环：对外的入口是隧道或中继，不是这个端口。
# 页面脚本由本服务启动，所以这一节的沙箱就是"页面代码能碰什么"的边界。
ExecStart=/srv/nac/bin/contentd \
    --data /srv/nac/data \
    --port 7000 \
    --bind 127.0.0.1 \
    --log /srv/nac/data/access.jsonl \
    --session-ttl-hours 168
Restart=always
RestartSec=2

# --- 提权面：全部关掉 ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes

# --- 文件系统：只读 + 仅有的可写范围 ---
# 公开站点只写 state/、appdata/ 与日志；gen/ 与 current 只读，archive/ 不开放。
ProtectSystem=strict
ReadWritePaths=/srv/nac/data/state /srv/nac/data/appdata /srv/nac/data/access.jsonl
# 运营台的源码与数据对它完全不可见；不同 UID 也阻断 /proc/<pid>/root。
InaccessiblePaths=/srv/nac/admin
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# 会话/appdata 需组读，运营台才能看留言与统计。
UMask=0007
MemoryMax=256M
TasksMax=128
LimitNOFILE=1024
# systemd 257：对其他用户隐藏进程；不同 UID 已阻断 /proc/<pid>/root。
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=~@debug

[Install]
WantedBy=multi-user.target
