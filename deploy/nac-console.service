[Unit]
Description=nac ops console (local only)
After=network.target

[Service]
Type=simple
User=nac
Group=nac
WorkingDirectory=/srv/nac
# 运营台永远只监听 127.0.0.1；远程访问用 ssh -L，不在防火墙上开口。
# 它要能写公开站点的 data/ 才能在页面里点"发布"，所以可写范围比公开站点多一份。
ExecStart=/srv/nac/bin/contentd \
    --data /srv/nac/admin/data \
    --port 7001 \
    --bind 127.0.0.1 \
    --env NAC_ROOT=/srv/nac \
    --env NAC_LOG=/srv/nac/data/access.jsonl
Restart=always
RestartSec=2

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes

ProtectSystem=strict
# 自己的 data/ + 公开站点的 data/（发布用）+ archive/
ReadWritePaths=/srv/nac/admin/data /srv/nac/data -/srv/nac/archive
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
UMask=0077
# 更严的几条需要较新 systemd（242 / 245 / 247），确认版本后再放开：
# ProtectHostname=yes
# ProtectClock=yes
# ProtectProc=invisible

[Install]
WantedBy=multi-user.target